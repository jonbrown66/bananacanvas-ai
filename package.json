  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:pm": "node scripts/check-package-manager.cjs",
    "dev": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));process.exit(require(p.join(r,'scripts','run-next.cjs'))('dev'));\"",
    "build": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));process.exit(require(p.join(r,'scripts','run-next.cjs'))('build'));\"",
    "test:security": "node tests/security/route-guards.smoke.mjs",
    "start": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));process.exit(require(p.join(r,'scripts','run-next.cjs'))('start'));\"",
    "lint": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));process.exit(require(p.join(r,'scripts','run-next.cjs'))('lint'));\"",
    "predev": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));require(p.join(r,'scripts','ensure-next-cjs.cjs'));\"",
    "prebuild": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));require(p.join(r,'scripts','ensure-next-cjs.cjs'));\"",
    "prestart": "node -e \"const p=require('node:path');const r=p.dirname(process.env.npm_package_json||p.join(process.cwd(),'package.json'));require(p.join(r,'scripts','ensure-next-cjs.cjs'));\""
  },
